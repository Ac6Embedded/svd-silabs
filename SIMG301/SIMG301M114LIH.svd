                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Input is inverted before it is passed to the receiver</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
