              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>No filter enabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Filter enabled. IrDA pulse must be high for at least 5 consecutive clock cycles to be detected</description>
                  <value>1</value>
                </enumeratedValue>
