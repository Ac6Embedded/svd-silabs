              <name>WARMUPMODE</name>
              <description>Warmup Mode</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>Shut down the analog ADC after conversions have completed. Requires 5 us warmup time on first conversion of any new scan.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEPWARM</name>
                  <description>Keep ADC fully powered after conversions have completed.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEPSTANDBY</name>
                  <description>Keep ADC in low-power standby state after conversions have completed. Requires 1 us warmup time on first converion of any new scan.</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
