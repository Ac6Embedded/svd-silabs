                  <value>16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EIGHTEENFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least eighteen more frames. </description>
                  <value>17</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NINETEENFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least nineteen more frames. </description>
                  <value>18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twenty more frames. </description>
                  <value>19</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYONEFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twentyone more frames. </description>
                  <value>20</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYTWOFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twentytwo more frames. </description>
                  <value>21</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYTHREEFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twentythree more frames. </description>
                  <value>22</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYFOURFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twentyfour more frames. </description>
                  <value>23</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWENTYFIVEFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least twentyfive more frames. </description>
                  <value>24</value>
                </enumeratedValue>
                <enumeratedValue>
