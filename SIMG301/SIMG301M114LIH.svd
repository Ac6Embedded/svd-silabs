        <register>
          <name>GAINCAL0</name>
          <description>gain calibration</description>
          <addressOffset>0x05C</addressOffset>
          <access>read-write</access>
          <resetValue>0x06018060</resetValue>
          <resetMask>0x07F1FC7F</resetMask>
          <fields>
            <field>
              <name>SEPOS</name>
              <description>Gain Calibration for Single Ended Positive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SENEG</name>
              <description>Gain Calibration for Single Ended Negative</description>
              <bitOffset>10</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
