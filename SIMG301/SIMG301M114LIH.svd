                <enumeratedValue>
                  <name>IDLEHIGH</name>
                  <description>The bus clock used in synchronous mode has a high base value</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKPHA</name>
