        <register>
          <name>TRIGGER</name>
          <description>trigger settings</description>
          <addressOffset>0x02C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x07800017</resetMask>
          <fields>
            <field>
              <name>SCANTRIGSEL</name>
              <description>Scan Trigger Select</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IMMEDIATE</name>
                  <description>Immediate triggering. The scan queue will be disabled once all conversions in the scan table are complete, unless TRIGGERACTION is set to continuous.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER</name>
                  <description>Triggers when the local timer count reaches zero. </description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRSCLKGRP</name>
                  <description>Triggers on PRS0 from a timer module that is using the same clock group as the ADC and has been programmed to use the same clock source as the ADC.  The prescale may be different between the ADC and the timer module.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRSPOS</name>
                  <description>Triggers on asynchronous PRS0 positive edge.  Requires PRS0 to go low for 3 ADCCLKs before another positive edge can be detected.  Generates an additional delay of 1 to 2 CLK_SRC_ADC cycles for synchronization.</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRSNEG</name>
                  <description>Triggers on asynchronous PRS0 negative edge.  Requires PRS0 to go high for 3 ADCCLKs before another negative edge can be detected.  Generates an additional delay of 1 to 2 CLK_SRC_ADC cycles for synchronization.  PRSNEG should only be used when the PRS trigger source is from a module on a PD0 or PDHV power domain.  For modules (ie: TIMER) on a PD1 power domain, PRSPOS should be used for an asynchronous trigger, and PRSCLKGRP should be used for a synchronous trigger.</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SCANTRIGACTION</name>
              <description>Scan trigger action</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ONCE</name>
                  <description>Goes through scan table once per trigger</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CONTINUOUS</name>
                  <description>goes through the scan table converts every entry in maskbit and keeps going through the table until stop command is issued or module is diabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REPDELAY</name>
              <description>delay between repetitions</description>
              <bitOffset>23</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NODELAY</name>
                  <description>No delay</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE2</name>
                  <description>2 conversion clock cycles</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE4</name>
                  <description>4 conversion clock cycles</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE8</name>
                  <description>8 conversion clock cycles</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE16</name>
                  <description>16 conversion clock cycles</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE32</name>
                  <description>32 conversion clock cycles</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE64</name>
                  <description>64 conversion clock cycles</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE128</name>
                  <description>128 conversion clock cycles</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE256</name>
                  <description>256 conversion clock cycles</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE512</name>
                  <description>512 conversion clock cycles</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLE1024</name>
                  <description>1024 conversion clock cycles</description>
                  <value>10</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CFG0</name>
