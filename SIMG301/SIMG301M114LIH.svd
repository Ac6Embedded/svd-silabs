              <enumeratedValues>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Input common mode voltage can be rail-to-rail. This setting can always be used for BIAS &gt;= 4. When BIAS is 0, 1, 2, or 3, additional offset may occur at common mode voltages above 3.0 V.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>Input common mode voltage above 3.0 V. This setting can be used when BIAS is 0, 1, 2, or 3 to improve the offset performance at common mode voltages above 3.0 V.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
