                <enumeratedValue>
                  <name>THIRTEENFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least thriteen more frames. </description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOURTEENFRAMES</name>
