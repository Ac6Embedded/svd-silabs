                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>A bus idle timeout tells the I2C module that the bus is idle, allowing new transfers to be initiated.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
