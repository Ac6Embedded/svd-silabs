                </enumeratedValue>
                <enumeratedValue>
                  <name>I2C80PCC</name>
                  <description>Timeout after 80 prescaled clock cycles. In standard mode at 100 kHz, this results in a 100us timeout.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>I2C160PCC</name>
