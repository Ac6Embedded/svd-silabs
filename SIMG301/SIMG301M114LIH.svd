                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X8</name>
                  <description>8 samples for each conversion result</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X16</name>
                  <description>16 samples for each conversion result</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X32</name>
                  <description>32 samples for each conversion result</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X64</name>
                  <description>64 samples for each conversion result</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X128</name>
                  <description>128 samples for each conversion result</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X256</name>
                  <description>256 samples for each conversion result</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X512</name>
                  <description>512 samples for each conversion result</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>X1024</name>
                  <description>1024 samples for each conversion result</description>
                  <value>10</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>OFFSETSE0</name>
          <description>offset trimming</description>
          <addressOffset>0x054</addressOffset>
          <access>read-write</access>
          <resetValue>0x08000800</resetValue>
          <resetMask>0x0FFF0FFF</resetMask>
          <fields>
            <field>
              <name>SEPOS</name>
              <description>Offset Trim Single Ended Positive</description>
