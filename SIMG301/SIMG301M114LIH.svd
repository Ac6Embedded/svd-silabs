    <peripheral>
      <name>ADC0_S</name>
      <version>1</version>
      <description>ADC0_S Registers</description>
      <baseAddress>0x50004000</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x00001000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ADC0</name>
        <value>76</value>
      </interrupt>
      <registers>
        <register>
          <name>IPVERSION</name>
          <description>IPVERSION</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IPVERSION</name>
              <description>IP version ID</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EN</name>
          <description>Enable</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable SAR Module</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DISABLING</name>
              <description>Disablement busy status</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>Control </description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <resetValue>0x020F8000</resetValue>
          <resetMask>0xFFFF87FF</resetMask>
          <fields>
            <field>
              <name>DBGHALT</name>
              <description>Debug Halt</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>Continue operation as normal during debug mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HALT</name>
                  <description>Complete the current conversion and then halt during debug mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WARMUPMODE</name>
              <description>Warmup Mode</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>Shut down the analog ADC after conversions have completed. Requires 5 us warmup time on first conversion of any new scan.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEPWARM</name>
                  <description>Keep ADC fully powered after conversions have completed.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEPSTANDBY</name>
                  <description>Keep ADC in low-power standby state after conversions have completed. Requires 1 us warmup time on first converion of any new scan.</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCPRESCALE</name>
              <description>Second Prescaler</description>
              <bitOffset>5</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIMEBASE</name>
              <description>Time Base</description>
              <bitOffset>15</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REFSEL</name>
              <description>Reference Selection</description>
              <bitOffset>22</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VREFINT</name>
                  <description>Internal voltage reference</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VREFPL</name>
                  <description>External reference pin low voltage (1.05-1.25)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VREFPH</name>
                  <description>External reference pin high voltage( &gt;1.25)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VDDA</name>
                  <description>Analog voltage supply</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VREFPBUF</name>
                  <description>External reference pin buffered</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSCLKRATE</name>
              <description>High Speed Prescaler</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV1</name>
                  <description>Use clk_per directly.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV2</name>
                  <description>Divide clk_per by 2 before using it.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV3</name>
                  <description>Divide clk_per by 3 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>Divide clk_per by 4 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV5</name>
                  <description>Divide clk_per by 5 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV6</name>
                  <description>Divide clk_per by 6 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV7</name>
                  <description>Divide clk_per by 7 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV8</name>
                  <description>Divide clk_per by 8 before using it. the resulting clk_src_adc must be 40Mhz or less</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
