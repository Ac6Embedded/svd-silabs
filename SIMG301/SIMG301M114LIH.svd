                <enumeratedValue>
                  <name>SINGLE</name>
                  <description>Transmission of new frames is delayed by a single bit period.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DOUBLE</name>
                  <description>Transmission of new frames is delayed by a two bit periods.</description>
