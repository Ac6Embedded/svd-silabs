                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIXTEENFRAMES</name>
                  <description>TXFL status flag and IF are set when the TX FIFO has space for at least sixteen more frames. </description>
                  <value>15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SEVENTEENFRAMES</name>
