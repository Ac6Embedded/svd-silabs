                </enumeratedValue>
                <enumeratedValue>
                  <name>AH</name>
                  <description>Chip select is active high</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AUTOTX</name>
