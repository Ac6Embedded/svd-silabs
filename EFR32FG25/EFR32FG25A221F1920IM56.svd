              <enumeratedValues>
                <enumeratedValue>
                  <name>ZERO</name>
                  <description>CS is de-asserted half or 1 baud-time after the end of transmission depending on CLKPHASE equal to 1 or 0 respectively</description>
                  <value>0</value>
