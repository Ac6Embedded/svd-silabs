                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GE</name>
                  <description>Comparison evaluates to 1 if sensor data is greater than, or equal to CTRTHRESHOLD, or if the ACMP output is 1</description>
                  <value>1</value>
                </enumeratedValue>
