                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATA</name>
                  <description>Data transmit or receive phase</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DATAACK</name>
                  <description>Data ack/nack transmit or receive phase</description>
                  <value>6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
