                </enumeratedValue>
                <enumeratedValue>
                  <name>DOUBLE</name>
                  <description>Transmission of new frames is delayed by a two bit periods.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIPPLE</name>
                  <description>Transmission of new frames is delayed by a three bit periods.</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
