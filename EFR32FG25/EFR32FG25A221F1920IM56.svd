                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THIRTEENFRAMES</name>
                  <description>RXFL status flag and IF are set when the RX FIFO has at least thriteen frames in it. </description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOURTEENFRAMES</name>
