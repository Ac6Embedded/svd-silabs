                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Received framing and parity errors disable the transmitter</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
