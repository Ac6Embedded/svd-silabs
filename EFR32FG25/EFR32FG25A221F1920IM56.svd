                  <description>Timeout period of 2048 cycles</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLES4K</name>
                  <description>Timeout period of 4096 cycles</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLES8K</name>
                  <description>Timeout period of 8192 cycles</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLES16K</name>
                  <description>Timeout period of 16384 cycles</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CYCLES32K</name>
                  <description>Timeout period of 32768 cycles</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
