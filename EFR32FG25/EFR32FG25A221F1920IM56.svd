                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONE</name>
                  <description>CS is de-asserted 1 additional baud-time after the end of transmission</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>CS is de-asserted 2 additional baud-times after the end of transmission</description>
                  <value>2</value>
